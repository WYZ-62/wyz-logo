---
import type { MarkdownHeading } from "astro";

import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getSortedPostsList } from "@/utils/content-utils";
import { pathsEqual } from "@/utils/url-utils";

import WidgetLayout from "../common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	headings?: MarkdownHeading[];
}

const {
	class: className,
	style,
	headings = [],
} = Astro.props as Props;

const currentPath = Astro.url.pathname;
const hasArticleHeadings = headings.length > 0;

const allPosts = await getSortedPostsList();

const visiblePosts = allPosts
	.filter((post) => !post.data.password && post.url)
	.map((post, index) => ({
		...post,
		order: index + 1,
		category:
			typeof post.data.category === "string" &&
			post.data.category.trim().length > 0
				? post.data.category.trim()
				: i18n(I18nKey.uncategorized),
		isActive: post.url ? pathsEqual(currentPath, post.url) : false,
	}));
---

<WidgetLayout
	name="目录"
	id="card-toc"
	class={"group " + (className || "")}
	style={style}
>
	{
		hasArticleHeadings ? (
			<table-of-contents-card
				class="toc-card-root"
				data-has-article-headings={String(hasArticleHeadings)}
			>
				<div
					class="toc-scroll-container article-toc-list"
					data-card-toc-content
				></div>
			</table-of-contents-card>
		) : (
			<div class="doc-list home-doc-list">
				{
					visiblePosts.length > 0 ? (
						visiblePosts.map((post) => (
							<a
								href={post.url}
								class:list={[
									"doc-item",
									{ active: post.isActive },
								]}
								aria-current={post.isActive ? "page" : undefined}
							>
								<span class="doc-index">{post.order}</span>
								<span class="doc-copy">
									<span class="doc-title">{post.data.title}</span>
									<span class="doc-meta">{post.category}</span>
								</span>
							</a>
						))
					) : (
						<div class="doc-empty">暂时还没有可展示的文档</div>
					)
				}
			</div>
		)
	}
</WidgetLayout>

<script>
	import { TOCManager, isPostPage } from "@/utils/tocManager";

	class CardTableOfContents extends HTMLElement {
		manager: TOCManager | null = null;
		contentEl: HTMLElement | null = null;
		cleanupInit: (() => void) | null = null;

		connectedCallback() {
			this.contentEl = this.querySelector(
				"[data-card-toc-content]",
			) as HTMLElement | null;
			const hasArticleHeadings =
				this.dataset.hasArticleHeadings === "true";

			if (!this.contentEl) {
				return;
			}

			if (!hasArticleHeadings || !isPostPage()) {
				this.contentEl.innerHTML = "";
				return;
			}

			const initTOC = () => {
				this.manager?.cleanup();
				this.manager = new TOCManager({
					contentElement: this.contentEl || undefined,
					maxLevel: window.siteConfig?.toc?.depth ?? 3,
					scrollOffset: 80,
					useJapaneseBadge:
						window.siteConfig?.toc?.useJapaneseBadge ?? false,
				});
				this.manager.init();
			};

			initTOC();
			document.addEventListener("astro:page-load", initTOC);
			this.cleanupInit = () => {
				document.removeEventListener("astro:page-load", initTOC);
			};
		}

		disconnectedCallback() {
			this.manager?.cleanup();
			this.manager = null;
			this.cleanupInit?.();
			this.cleanupInit = null;
		}
	}

	if (!customElements.get("table-of-contents-card")) {
		customElements.define("table-of-contents-card", CardTableOfContents);
	}
</script>

<style>
	.toc-card-root {
		display: block;
	}

	.home-doc-list,
	.article-toc-list {
		display: flex;
		flex-direction: column;
		overflow-y: auto;
		overscroll-behavior: contain;
		scroll-behavior: smooth;
		scrollbar-gutter: stable;
		max-height: min(34.5rem, calc(100vh - 11rem));
		scrollbar-width: thin;
		scrollbar-color: transparent transparent;
		position: relative;
	}

	.home-doc-list {
		gap: 0.34rem;
		padding: 0.14rem 0.02rem 0.26rem;
	}

	.article-toc-list {
		gap: 0.06rem;
		padding: 0.04rem 0.02rem 0.08rem 0;
		max-height: min(39rem, calc(100vh - 8.9rem));
		border-radius: 1rem;
		background: transparent;
		border: none;
		box-shadow: none;
	}

	.home-doc-list::-webkit-scrollbar,
	.article-toc-list::-webkit-scrollbar {
		width: 0.16rem;
	}

	.home-doc-list::-webkit-scrollbar-track,
	.article-toc-list::-webkit-scrollbar-track {
		background: transparent;
	}

	.home-doc-list::-webkit-scrollbar-thumb,
	.article-toc-list::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: transparent;
		transition: background 0.2s ease;
	}

	.home-doc-list:hover,
	.article-toc-list:hover {
		scrollbar-color: color-mix(in oklab, var(--primary) 16%, transparent)
			transparent;
	}

	.home-doc-list:hover::-webkit-scrollbar-thumb {
		background: color-mix(in oklab, var(--primary) 16%, transparent);
	}

	.article-toc-list:hover::-webkit-scrollbar-thumb {
		background: color-mix(in oklab, #7db0ff 14%, transparent);
	}

	.home-doc-list:active::-webkit-scrollbar-thumb {
		background: color-mix(in oklab, var(--primary) 22%, transparent);
	}

	.article-toc-list:active::-webkit-scrollbar-thumb {
		background: color-mix(in oklab, #7db0ff 18%, transparent);
	}

	.doc-item {
		display: grid;
		grid-template-columns: 2.1rem minmax(0, 1fr);
		align-items: start;
		gap: 0.72rem;
		padding: 0.72rem 0.8rem;
		border-radius: 0.82rem;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease,
			border-color 0.2s ease;
		position: relative;
		background: transparent;
		border: 1px solid transparent;
	}

	.doc-item:hover {
		background: color-mix(in oklab, var(--primary) 5%, white 95%);
		transform: translateX(2px);
	}

	.doc-item.active {
		background: linear-gradient(
			135deg,
			color-mix(in oklab, var(--primary) 8%, white 92%) 0%,
			color-mix(in oklab, var(--primary) 4%, white 96%) 100%
		);
		border-color: color-mix(in oklab, var(--primary) 5%, white 95%);
		box-shadow: 0 10px 20px -30px
			color-mix(in oklab, var(--primary) 18%, transparent);
	}

	.doc-index {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.72rem;
		height: 1.72rem;
		border-radius: 999px;
		background: linear-gradient(
			135deg,
			color-mix(in oklab, var(--primary) 22%, white 78%) 0%,
			color-mix(in oklab, var(--primary) 14%, white 86%) 100%
		);
		color: color-mix(in oklab, var(--primary) 78%, black);
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1;
		flex-shrink: 0;
		margin-top: 0.1rem;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
	}

	.doc-item.active .doc-index {
		background: linear-gradient(
			135deg,
			color-mix(in oklab, var(--primary) 28%, white 72%) 0%,
			color-mix(in oklab, var(--primary) 18%, white 82%) 100%
		);
		color: color-mix(in oklab, var(--primary) 74%, black);
	}

	.doc-copy {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.16rem;
	}

	.doc-title {
		color: color-mix(in oklab, var(--deep-text) 82%, #7f6149 18%);
		font-size: 0.92rem;
		font-weight: 500;
		line-height: 1.52;
		letter-spacing: 0;
		word-break: break-word;
		text-wrap: pretty;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.doc-meta {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		max-width: 100%;
		color: color-mix(in oklab, var(--primary) 72%, #9d6a3f 28%);
		font-size: 0.76rem;
		font-weight: 400;
		line-height: 1.35;
		letter-spacing: 0.02em;
	}

	.doc-item.active .doc-title {
		color: color-mix(in oklab, var(--deep-text) 78%, #7a5c46 22%);
	}

	:global(.article-toc-list .toc-item) {
		display: grid;
		grid-template-columns: 0.5rem minmax(0, 1fr);
		align-items: start;
		gap: 0.34rem;
		padding: 0.44rem 0.42rem;
		border-radius: 0.66rem;
		text-decoration: none;
		border: 1px solid transparent;
		background: transparent;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	:global(.article-toc-list .toc-item:hover) {
		background: color-mix(in oklab, #7db0ff 3%, transparent);
		transform: translateX(1px);
	}

	:global(.article-toc-list .toc-item.visible) {
		background: linear-gradient(
			135deg,
			color-mix(in oklab, #6ea8ff 12%, white 88%) 0%,
			color-mix(in oklab, #6ea8ff 5%, white 95%) 100%
		);
		border-color: color-mix(in oklab, #6ea8ff 6%, white 94%);
		box-shadow: 0 8px 18px -30px rgba(110, 168, 255, 0.28);
	}

	:global(.article-toc-list .toc-badge) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: transparent;
		color: #69a4ff;
		font-size: 0.56rem;
		font-weight: 600;
		line-height: 1;
		margin-top: 0.16rem;
		flex-shrink: 0;
	}

	:global(.article-toc-list .toc-item.visible .toc-badge) {
		color: #6aa6ff;
	}

	:global(.article-toc-list .toc-badge.toc-badge-index) {
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 0.28rem;
		background: color-mix(in oklab, #6ea8ff 11%, white 89%);
		color: #5d96f0;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
	}

	:global(.article-toc-list .toc-item.visible .toc-badge.toc-badge-index) {
		background: color-mix(in oklab, #6ea8ff 14%, white 86%);
		color: #5b98f3;
	}

	:global(.article-toc-list .toc-badge:not(.toc-badge-index)) {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: transparent;
	}

	:global(.article-toc-list .toc-badge-dot) {
		width: 0.22rem;
		height: 0.22rem;
		border-radius: 999px;
		background: #d8dde7;
		display: inline-block;
	}

	:global(.article-toc-list .toc-badge-dot-sm) {
		width: 0.16rem;
		height: 0.16rem;
		border-radius: 999px;
		background: #d8dde7;
		display: inline-block;
	}

	:global(.article-toc-list .toc-item.visible .toc-badge-dot),
	:global(.article-toc-list .toc-item.visible .toc-badge-dot-sm) {
		background: #6aa6ff;
	}

	:global(.article-toc-list .toc-label) {
		min-width: 0;
		color: color-mix(in oklab, var(--deep-text) 84%, #4a5870 16%);
		line-height: 1.34;
		letter-spacing: 0;
		word-break: break-word;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:global(.article-toc-list .toc-label-primary) {
		font-size: 0.82rem;
		font-weight: 500;
	}

	:global(.article-toc-list .toc-label-secondary) {
		font-size: 0.78rem;
		font-weight: 500;
		color: color-mix(in oklab, var(--deep-text) 74%, #8892a3 26%);
	}

	:global(.article-toc-list .toc-item.visible .toc-label) {
		color: #6aa6ff;
	}

	.doc-empty,
	:global(.article-toc-list .text-center) {
		padding: 0.85rem 0.25rem 0.5rem;
		color: var(--content-meta);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	:global(.article-toc-list .toc-active-indicator) {
		display: none;
	}

	:global(.article-toc-list .toc-item.toc-level-0) {
		grid-template-columns: 0.9rem minmax(0, 1fr);
		gap: 0.38rem;
		padding-left: 0.26rem;
	}

	:global(.article-toc-list .toc-item.toc-level-1) {
		padding-left: 0.34rem;
	}

	:global(.article-toc-list .toc-item.toc-level-2) {
		padding-left: 0.46rem;
	}

	:global(.article-toc-list .toc-item.toc-level-1 .toc-label),
	:global(.article-toc-list .toc-item.toc-level-2 .toc-label) {
		font-weight: 500;
	}

	:global(.article-toc-list .toc-item.toc-level-0 .toc-label) {
		font-size: 0.86rem;
		font-weight: 600;
		-webkit-line-clamp: 1;
	}

	:global(.article-toc-list .toc-item.toc-level-2 .toc-label) {
		font-size: 0.76rem;
	}

	:global(.dark) .doc-item {
		background: transparent;
		border-color: transparent;
	}

	:global(.dark) .doc-item:hover {
		background: color-mix(in oklab, var(--primary) 12%, transparent);
	}

	:global(.dark) .doc-item.active {
		background: color-mix(in oklab, var(--primary) 18%, transparent);
		border-color: color-mix(in oklab, var(--primary) 14%, transparent);
	}

	:global(.dark) .doc-title {
		color: color-mix(in oklab, white 92%, var(--primary) 8%);
	}

	:global(.dark) .doc-meta {
		color: color-mix(in oklab, var(--primary) 72%, white 28%);
	}

	:global(.dark) .doc-empty,
	:global(.dark) .article-toc-list .text-center {
		color: var(--content-meta);
	}

	:global(.dark) .article-toc-list {
		background: transparent;
		border-color: transparent;
		box-shadow: none;
	}

	:global(.dark) .article-toc-list .toc-item {
		background: transparent;
		border-color: transparent;
	}

	:global(.dark) .article-toc-list .toc-item:hover {
		background: color-mix(in oklab, #7db0ff 8%, transparent);
	}

	:global(.dark) .article-toc-list .toc-item.visible {
		background: linear-gradient(
			135deg,
			color-mix(in oklab, #6ea8ff 14%, transparent) 0%,
			color-mix(in oklab, #6ea8ff 6%, transparent) 100%
		);
		border-color: color-mix(in oklab, #6ea8ff 8%, transparent);
	}

	:global(.dark) .article-toc-list .toc-badge {
		background: transparent;
		color: #8cb8ff;
	}

	:global(.dark) .article-toc-list .toc-badge.toc-badge-index {
		background: color-mix(in oklab, #6ea8ff 14%, transparent);
	}

	:global(.dark) .article-toc-list .toc-item.visible .toc-badge {
		color: #9ac1ff;
	}

	:global(.dark) .article-toc-list .toc-badge-dot {
		background: color-mix(in oklab, white 70%, #7c8aa3 30%);
	}

	:global(.dark) .article-toc-list .toc-badge-dot-sm {
		background: color-mix(in oklab, white 54%, #73819a 46%);
	}

	:global(.dark) .article-toc-list .toc-label {
		color: color-mix(in oklab, white 90%, #7db0ff 10%);
	}

	:global(.dark) .article-toc-list .toc-label-secondary {
		color: color-mix(in oklab, white 72%, #9fb7de 28%);
	}
</style>
