---
import { Icon } from "astro-icon/components";

import { LinkPresets } from "../../../constants/link-presets";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import {
	getPoeticName,
	getPoeticVariant,
} from "../../../utils/naming-style";
import { url } from "../../../utils/url-utils";
import type { DropdownMenuProps } from "./types";

const { link, class: className } = Astro.props as DropdownMenuProps;

const navTitleMap: Record<string, I18nKey> = {
	Links: I18nKey.navLinks,
	My: I18nKey.navMy,
	我的: I18nKey.navMy,
	About: I18nKey.navAbout,
	Others: I18nKey.navOthers,
	Anime: I18nKey.anime,
	Diary: I18nKey.diary,
	Gallery: I18nKey.albums,
	Devices: I18nKey.devices,
	Projects: I18nKey.projects,
	Skills: I18nKey.skills,
	Timeline: I18nKey.timeline,
	Friends: I18nKey.friends,
};

const getLocalizedName = (name: string): string => {
	return name in navTitleMap ? i18n(navTitleMap[name]) : name;
};

const getNameVariant = (name: string) => {
	const defaultName = getLocalizedName(name);

	return {
		defaultName,
		poeticName: getPoeticName(defaultName),
		poeticVariant: getPoeticVariant(defaultName),
	};
};

const children =
	link.children?.map((child) => {
		const resolvedChild =
			typeof child === "number" ? LinkPresets[child] : child;

		return {
			...resolvedChild,
			nameVariant: getNameVariant(resolvedChild.name),
		};
	}) ?? [];

const hasChildren = children.length > 0;
const isMyGroup = link.name === "My" || link.name === "我的";
const linkNameVariant = getNameVariant(link.name);
---

<div class:list={["dropdown-container group", className]} data-dropdown>
	{
		hasChildren ? (
			<>
				<button
					class="nav-link-trigger btn-plain scale-animation rounded-lg h-11 font-bold w-auto px-3 lg:px-5 active:scale-95 dropdown-trigger flex items-center justify-center md:justify-start whitespace-nowrap"
					aria-expanded="false"
					aria-haspopup="true"
					data-dropdown-trigger
					data-nav-group={isMyGroup ? "my" : undefined}
				>
					{link.icon && (
						<Icon
							name={link.icon}
							class="nav-link-top-icon text-[1.1rem] mr-1.5 lg:mr-2 flex-shrink-0"
						/>
					)}
					<span
						class="nav-label nav-label--top truncate"
						data-naming-label
						data-default-label={linkNameVariant.defaultName}
						data-poetic-label={linkNameVariant.poeticName}
						data-poetic-variant={linkNameVariant.poeticVariant}
					>
						{linkNameVariant.defaultName}
					</span>
					<Icon
						name="material-symbols:keyboard-arrow-down-rounded"
						class="nav-link-top-arrow text-[1.25rem] transition-transform duration-200 dropdown-arrow ml-1 flex-shrink-0"
					/>
				</button>

				<div class="dropdown-menu" data-dropdown-menu>
					<div class="dropdown-content">
						{children.map((child) => (
							<a
								href={
									child.external ? child.url : url(child.url)
								}
								target={child.external ? "_blank" : null}
								rel={
									child.external
										? "noopener noreferrer"
										: null
								}
								class="dropdown-item"
								aria-label={child.name}
							>
								<div class="flex items-center">
									{child.icon && (
										<Icon
											name={child.icon}
											class="text-[1rem] mr-2"
										/>
									)}
									<span
										class="nav-label nav-label--child"
										data-naming-label
										data-default-label={
											child.nameVariant.defaultName
										}
										data-poetic-label={
											child.nameVariant.poeticName
										}
										data-poetic-variant={
											child.nameVariant.poeticVariant
										}
									>
										{child.nameVariant.defaultName}
									</span>
								</div>
								{child.external && (
									<Icon
										name="fa7-solid:arrow-up-right-from-square"
										class="text-[0.75rem] text-black/25 dark:text-white/25 ml-2"
									/>
								)}
							</a>
						))}
					</div>
				</div>
			</>
		) : (
			<a
				aria-label={link.name}
				href={link.external ? link.url : url(link.url)}
				target={link.external ? "_blank" : null}
				rel={link.external ? "noopener noreferrer" : null}
				class="nav-link-trigger btn-plain scale-animation rounded-lg h-11 font-bold w-auto px-3 lg:px-5 active:scale-95 flex items-center justify-center md:justify-start whitespace-nowrap"
			>
				{link.icon && (
					<Icon
						name={link.icon}
						class="nav-link-top-icon text-[1.1rem] mr-1.5 lg:mr-2 flex-shrink-0"
					/>
				)}
				<span
					class="nav-label nav-label--top truncate"
					data-naming-label
					data-default-label={linkNameVariant.defaultName}
					data-poetic-label={linkNameVariant.poeticName}
					data-poetic-variant={linkNameVariant.poeticVariant}
				>
					{linkNameVariant.defaultName}
				</span>
				{link.external && (
					<Icon
						name="fa7-solid:arrow-up-right-from-square"
						class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2] flex-shrink-0"
					/>
				)}
			</a>
		)
	}
</div>

<style>
	@reference "tailwindcss";
	@custom-variant dark (&:where(.dark, .dark *));

	.dropdown-container {
		@apply relative;
	}

	.dropdown-menu {
		@apply absolute top-full left-0 pt-3 opacity-0 invisible pointer-events-none translate-y-[-8px] transition-all duration-200 ease-out z-50;
	}

	.dropdown-trigger[aria-expanded="true"] + .dropdown-menu {
		@apply opacity-100 visible pointer-events-auto translate-y-0;
	}

	.dropdown-trigger[aria-expanded="true"] .dropdown-arrow {
		@apply rotate-180;
	}

	.dropdown-content {
		@apply relative rounded-[1.35rem] border p-3 min-w-[15rem];
		background:
			repeating-linear-gradient(
				0deg,
				transparent,
				transparent 1.72rem,
				rgb(200 185 170 / 0.09) 1.72rem,
				rgb(200 185 170 / 0.09) 1.8rem
			),
			repeating-linear-gradient(
				90deg,
				transparent,
				transparent 2.2rem,
				rgb(200 185 170 / 0.05) 2.2rem,
				rgb(200 185 170 / 0.05) 2.28rem
			),
			radial-gradient(circle at 18% 16%, rgb(255 255 255 / 0.82), transparent 36%),
			linear-gradient(180deg, rgb(252 250 246 / 0.98), rgb(244 238 229 / 0.94));
		border-color: rgb(216 208 198 / 0.72);
		box-shadow:
			0 1.2rem 2.2rem rgb(47 37 28 / 0.12),
			inset 0 0 0 1px rgb(255 255 255 / 0.48);
	}

	.dropdown-content::before {
		content: "";
		position: absolute;
		left: 1rem;
		right: 1rem;
		top: -0.38rem;
		height: 0.42rem;
		border-radius: 999px;
		background: linear-gradient(
			180deg,
			rgb(182 154 120 / 0.96),
			rgb(132 104 75 / 0.96)
		);
		box-shadow:
			0 0.1rem 0.3rem rgb(58 41 26 / 0.18),
			inset 0 0.06rem 0.08rem rgb(255 255 255 / 0.18);
	}

	.dropdown-content::after {
		content: "";
		position: absolute;
		left: 50%;
		top: -0.92rem;
		width: 3.25rem;
		height: 1.05rem;
		border-radius: 999px 999px 0.3rem 0.3rem;
		background:
			radial-gradient(circle at 50% 28%, rgb(255 255 255 / 0.28), transparent 48%),
			linear-gradient(180deg, rgb(198 171 138 / 0.96), rgb(151 122 90 / 0.96));
		transform: translateX(-50%);
		box-shadow: 0 0.14rem 0.32rem rgb(58 41 26 / 0.16);
	}

	.dropdown-item {
		@apply relative flex items-center justify-between px-3 py-2.5 text-black/75 dark:text-white/75 transition-colors duration-150 font-medium rounded-none;
		background: transparent !important;
	}

	.dropdown-item::after {
		content: "";
		position: absolute;
		left: 0.9rem;
		right: 0.9rem;
		bottom: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			rgb(212 201 190 / 0.72),
			transparent
		);
	}

	.dropdown-item:last-child::after {
		display: none;
	}

	.dropdown-item:hover {
		transform: translateX(2px);
	}

	.dropdown-item > div {
		min-width: 0;
	}

	.dropdown-item > div > span {
		max-width: 100%;
	}

	.dropdown-trigger[data-nav-group="my"]:hover,
	.dropdown-trigger[data-nav-group="my"]:focus-visible,
	.dropdown-trigger[data-nav-group="my"][aria-expanded="true"] {
		background: transparent;
		color: inherit;
	}

	:global(.dark) .dropdown-content {
		background:
			repeating-linear-gradient(
				0deg,
				transparent,
				transparent 1.72rem,
				rgb(255 255 255 / 0.04) 1.72rem,
				rgb(255 255 255 / 0.04) 1.8rem
			),
			repeating-linear-gradient(
				90deg,
				transparent,
				transparent 2.2rem,
				rgb(255 255 255 / 0.025) 2.2rem,
				rgb(255 255 255 / 0.025) 2.28rem
			),
			radial-gradient(circle at 18% 16%, rgb(255 255 255 / 0.06), transparent 36%),
			linear-gradient(180deg, rgb(39 35 33 / 0.96), rgb(26 23 21 / 0.94));
		border-color: rgb(255 255 255 / 0.12);
		box-shadow:
			0 1.2rem 2.2rem rgb(0 0 0 / 0.28),
			inset 0 0 0 1px rgb(255 255 255 / 0.06);
	}

	:global(.dark) .dropdown-content::before {
		background: linear-gradient(
			180deg,
			rgb(130 103 72 / 0.96),
			rgb(95 72 48 / 0.96)
		);
	}

	:global(.dark) .dropdown-content::after {
		background:
			radial-gradient(circle at 50% 28%, rgb(255 255 255 / 0.12), transparent 48%),
			linear-gradient(180deg, rgb(142 116 84 / 0.96), rgb(107 82 58 / 0.96));
	}

	:global(.dark) .dropdown-item::after {
		background: linear-gradient(
			90deg,
			transparent,
			rgb(255 255 255 / 0.14),
			transparent
		);
	}

	@media (max-width: 767px) {
		.dropdown-container {
			@apply hidden;
		}
	}
</style>

<script>
	function bindDropdownMenus() {
		if (document.documentElement.dataset.dropdownMenusBound === "true") {
			return;
		}

		document.documentElement.dataset.dropdownMenusBound = "true";

		const getDropdowns = () =>
			Array.from(
				document.querySelectorAll<HTMLElement>("[data-dropdown]"),
			);

		const getTrigger = (dropdown: HTMLElement) =>
			dropdown.querySelector<HTMLElement>("[data-dropdown-trigger]");

		const closeAllMenus = (exceptDropdown?: HTMLElement) => {
			getDropdowns().forEach((dropdown) => {
				if (dropdown !== exceptDropdown) {
					getTrigger(dropdown)?.setAttribute(
						"aria-expanded",
						"false",
					);
				}
			});
		};

		const openMenu = (dropdown: HTMLElement) => {
			closeAllMenus(dropdown);
			getTrigger(dropdown)?.setAttribute("aria-expanded", "true");
		};

		document.addEventListener("click", (event) => {
			const target = event.target as Element | null;
			const trigger = target?.closest<HTMLElement>(
				"[data-dropdown-trigger]",
			);

			if (trigger) {
				event.preventDefault();
				const dropdown =
					trigger.closest<HTMLElement>("[data-dropdown]");
				const isExpanded =
					trigger.getAttribute("aria-expanded") === "true";

				if (dropdown && !isExpanded) {
					openMenu(dropdown);
				} else {
					closeAllMenus();
				}
				return;
			}

			if (!target?.closest("[data-dropdown]")) {
				closeAllMenus();
			}
		});

		document.addEventListener("focusin", (event) => {
			const target = event.target as Element | null;
			const focusedDropdown =
				target?.closest<HTMLElement>("[data-dropdown]") ?? undefined;
			closeAllMenus(focusedDropdown);
		});

		document.addEventListener("keydown", (event) => {
			const target = event.target as Element | null;
			const dropdown = target?.closest<HTMLElement>("[data-dropdown]");

			if (event.key === "Escape") {
				const trigger = dropdown ? getTrigger(dropdown) : null;
				closeAllMenus();
				trigger?.focus();
				return;
			}

			const trigger = target?.closest<HTMLElement>(
				"[data-dropdown-trigger]",
			);
			if (trigger && dropdown) {
				if (event.key === "Enter" || event.key === " ") {
					event.preventDefault();
					if (trigger.getAttribute("aria-expanded") === "true") {
						closeAllMenus();
					} else {
						openMenu(dropdown);
					}
				} else if (event.key === "ArrowDown") {
					event.preventDefault();
					openMenu(dropdown);
					dropdown
						.querySelector<HTMLElement>(".dropdown-item")
						?.focus();
				}
				return;
			}

			const item = target?.closest<HTMLElement>(".dropdown-item");
			if (!item || !dropdown) {
				return;
			}

			const items = Array.from(
				dropdown.querySelectorAll<HTMLElement>(".dropdown-item"),
			);
			const currentIndex = items.indexOf(item);

			if (event.key === "ArrowDown" || event.key === "ArrowUp") {
				event.preventDefault();
				const direction = event.key === "ArrowDown" ? 1 : -1;
				items[
					(currentIndex + direction + items.length) % items.length
				]?.focus();
			}
		});

		const closeMenusOnViewportChange = () => closeAllMenus();
		window.addEventListener("scroll", closeMenusOnViewportChange, {
			passive: true,
		});
		window.addEventListener("wheel", closeMenusOnViewportChange, {
			passive: true,
		});
		window.addEventListener("resize", closeMenusOnViewportChange, {
			passive: true,
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", bindDropdownMenus, {
			once: true,
		});
	} else {
		bindDropdownMenus();
	}
</script>
