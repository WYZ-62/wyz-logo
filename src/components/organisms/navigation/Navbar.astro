---
import { Icon } from "astro-icon/components"

import { navBarConfig, siteConfig } from "../../../config"
import { LinkPresets } from "../../../constants/link-presets"
import { LinkPreset, type NavBarLink } from "../../../types/config"
import {
	DEFAULT_NAMING_STYLE,
	NAMING_STYLE_STORAGE_KEY,
} from "../../../utils/naming-style"
import { url } from "../../../utils/url-utils"
import LayoutSwitch from "../../control/LayoutSwitch.svelte"
import ThemeSwitch from "../../control/ThemeSwitch.svelte"
import DisplaySettings from "../../features/settings/DisplaySettings.svelte"
import WallpaperSwitch from "../../features/settings/WallpaperSwitch.svelte"
import MobileTOC from "../../features/toc/MobileTOC.svelte"
import DropdownMenu from "./DropdownMenu.astro"
import NavMenuPanel from "./NavMenuPanel.astro"
import Search from "./Search.svelte"

const className = Astro.props.class

// 获取导航栏透明模式配置
const navbarTransparentMode =
	siteConfig.banner?.navbar?.transparentMode || "semi";

// 获取整体布局方案切换按钮显示设置
const modeSwitchDisplay =
	siteConfig.wallpaperMode?.showModeSwitchOnMobile || "desktop";

// 检查是否为首页
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";

const links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);

const rawLogo = siteConfig.navbarTitle?.logo;
const logoSrc = rawLogo?.match(/^(http|https|\/\/)/) ? rawLogo : rawLogo ? url(rawLogo) : "";

const rawIcon = siteConfig.navbarTitle?.icon;
const iconSrc = rawIcon?.match(/^(http|https|\/\/)/) ? rawIcon : rawIcon ? url(rawIcon) : "";

const isLogoExternal = rawLogo?.match(/^(http|https|\/\/)/);
const isIconExternal = rawIcon?.match(/^(http|https|\/\/)/);
const hasLogoPngFallback = rawLogo?.endsWith(".png") && !isLogoExternal;
const hasIconPngFallback = rawIcon?.endsWith(".png") && !isIconExternal;
const logoWebpSrc = hasLogoPngFallback ? logoSrc.replace(/\.png$/i, ".webp") : logoSrc;
const iconWebpSrc = hasIconPngFallback ? iconSrc.replace(/\.png$/i, ".webp") : iconSrc;
---
<div
	id="navbar"
	class="z-50 onload-animation group"
	data-transparent-mode={navbarTransparentMode}
	data-is-home={isHomePage}
	data-default-naming-style={DEFAULT_NAMING_STYLE}
	data-naming-style-storage-key={NAMING_STYLE_STORAGE_KEY}
>
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[className, "!overflow-visible max-w-[var(--page-width)] h-[4.5rem] mx-auto flex items-center justify-between px-4"]}>
		<div class="flex items-center gap-2 shrink-0">
			<button
				type="button"
				aria-label="切换命名风格"
				aria-pressed="false"
				title="切换命名风格"
				class="naming-style-switch btn-plain scale-animation rounded-full h-9 px-1.5 active:scale-95"
				data-naming-style-switch
				data-naming-style={DEFAULT_NAMING_STYLE}
			>
				<span class="naming-style-switch__rail">
					<span
						class="naming-style-switch__chip"
						data-style-chip="default"
					>
						今
					</span>
					<span
						class="naming-style-switch__chip"
						data-style-chip="poetic"
					>
						雅
					</span>
				</span>
			</button>
			<a href={url('/')} class="btn-plain scale-animation rounded-lg h-[2.5rem] md:h-[3.25rem] md:[.enable-banner_&]:h-[2.5rem] md:[.enable-banner_&]:group-[.scrolled]:h-[3.25rem] px-5 font-bold active:scale-95 shrink-0 transition-all duration-300">
				<div class="flex flex-row items-center text-md">
					{/* 使用navbarTitle配置或默认配置 */}
					{siteConfig.navbarTitle ? (
						siteConfig.navbarTitle.mode === "logo" ? (
							hasLogoPngFallback ? (
								<picture>
									<source srcset={logoWebpSrc} type="image/webp" />
									<img src={logoSrc} alt={siteConfig.navbarTitle.text} class="h-[2.5rem] md:h-[3.25rem] md:[.enable-banner_&]:h-[2.5rem] md:[.enable-banner_&]:group-[.scrolled]:h-[3.25rem] max-w-full object-contain transition-all duration-300" loading="lazy" />
								</picture>
							) : (
								<img src={logoSrc} alt={siteConfig.navbarTitle.text} class="h-[2.5rem] md:h-[3.25rem] md:[.enable-banner_&]:h-[2.5rem] md:[.enable-banner_&]:group-[.scrolled]:h-[3.25rem] max-w-full object-contain transition-all duration-300" loading="lazy" />
							)
						) : (
							<>
								{hasIconPngFallback ? (
									<picture>
										<source srcset={iconWebpSrc} type="image/webp" />
										<img src={iconSrc} alt="" class="h-[1.75rem] w-[1.75rem] mr-2 object-contain" loading="lazy" />
									</picture>
								) : (
									<img src={iconSrc} alt="" class="h-[1.75rem] w-[1.75rem] mr-2 object-contain" loading="lazy" />
								)}
								<span class="dark:text-white text-black">{siteConfig.navbarTitle.text}</span>
							</>
						)
					) : (
						<>
							<Icon name="material-symbols:home-pin-outline" class="text-[1.75rem] mr-2" />
							<span class="dark:text-white text-black">{siteConfig.title}</span>
						</>
					)}
				</div>
			</a>
		</div>
        <div id="navbar-links-container" class="hidden md:flex items-center space-x-1 transition-opacity duration-300">
            {links.map((l) => {
                return <DropdownMenu link={l} />;
            })}
        </div>
        <div class="flex items-center gap-1">
            <div id="search-container">
                <Search client:only="svelte"></Search>
            </div>
            {/* 只在 sidebar 模式下显示移动端 TOC 按钮 */}
			{siteConfig.toc.enable && siteConfig.toc.mobileTop && <MobileTOC client:only="svelte"></MobileTOC>}
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LayoutSwitch client:only="svelte" currentLayout={siteConfig.postListLayout.defaultMode}></LayoutSwitch>
            <!-- 整体布局方案切换按钮：根据配置决定在哪些设备上显示 -->
            <div class:list={[
                modeSwitchDisplay === "off" ? "hidden" :
                modeSwitchDisplay === "mobile" ? "block md:hidden" :
                modeSwitchDisplay === "desktop" ? "hidden md:block" :
                modeSwitchDisplay === "both" ? "block" : "hidden md:block"
            ]}>
                <WallpaperSwitch client:only="svelte"></WallpaperSwitch>
            </div>
            <ThemeSwitch client:only="svelte"></ThemeSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:unfold-more" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<script>
	const searchContainer = document.getElementById("search-container");
	const navbarLinksContainer = document.getElementById("navbar-links-container");

	if (searchContainer && navbarLinksContainer) {
		// 鼠标移入/触摸开始时隐藏导航链接
		const hideLinks = () => {
			if (window.matchMedia("(min-width: 1280px)").matches && window.matchMedia("(hover: hover)").matches) {
				navbarLinksContainer.style.opacity = "0";
			}
		};

		// 鼠标移出/触摸结束时显示导航链接
		const showLinks = () => {
			const navbar = document.getElementById("navbar");
			if (navbar && !navbar.classList.contains("is-searching")) {
				navbarLinksContainer.style.opacity = "1";
			}
		};

		searchContainer.addEventListener("mouseenter", hideLinks);
		searchContainer.addEventListener("mouseleave", showLinks);

		// 移动端/触摸屏支持
		searchContainer.addEventListener("touchstart", hideLinks, { passive: true });
		searchContainer.addEventListener("touchend", showLinks);

		// 监听 navbar 的 class 变化，当搜索框折叠时确保链接显示
		const navbar = document.getElementById("navbar");
		if (navbar) {
			const observer = new MutationObserver((mutations) => {
				mutations.forEach((mutation) => {
					if (mutation.type === "attributes" && mutation.attributeName === "class") {
						if (!navbar.classList.contains("is-searching")) {
							// 搜索框已折叠，如果此时鼠标不在搜索容器内，强制显示链接
							if (!searchContainer.matches(':hover')) {
								showLinks();
							}
						}
					}
				});
			});
			observer.observe(navbar, { attributes: true });
		}
	}

async function loadButtonScript() {
    try {
        const { panelManager } = await import('../../../utils/panel-manager.js');
        
        const settingBtn = document.getElementById("display-settings-switch");
        if (settingBtn) {
            settingBtn.onclick = async function () {
                await panelManager.togglePanel('display-setting');
            };
        }

        const menuBtn = document.getElementById("nav-menu-switch");
        if (menuBtn) {
            menuBtn.onclick = async function () {
                await panelManager.togglePanel('nav-menu-panel');
            };
        }
    } catch (error) {
        console.error('Failed to load panel manager:', error);
        // 备用逻辑
        const settingBtn = document.getElementById("display-settings-switch");
        if (settingBtn) {
            settingBtn.onclick = function () {
                const settingPanel = document.getElementById("display-setting");
                if (settingPanel) {
                    settingPanel.classList.toggle("float-panel-closed");
                }
            };
        }

        const menuBtn = document.getElementById("nav-menu-switch");
        if (menuBtn) {
            menuBtn.onclick = function () {
                const menuPanel = document.getElementById("nav-menu-panel");
                if (menuPanel) {
                    menuPanel.classList.toggle("float-panel-closed");
                }
            };
        }
    }
}

loadButtonScript();

type ClientNamingStyle = "default" | "poetic";

function getNamingStyleConfig(): {
	defaultStyle: ClientNamingStyle;
	storageKey: string;
} {
	const navbar = document.getElementById("navbar");
	const defaultStyle =
		navbar?.dataset.defaultNamingStyle === "poetic"
			? "poetic"
			: "default";

	return {
		defaultStyle,
		storageKey:
			navbar?.dataset.namingStyleStorageKey || "mizuki:naming-style",
	};
}

function getNamingStyle(): ClientNamingStyle {
	const { defaultStyle, storageKey } = getNamingStyleConfig();

	try {
		const savedStyle = localStorage.getItem(storageKey);
		return savedStyle === "poetic" ? "poetic" : defaultStyle;
	} catch (error) {
		console.error("Failed to read naming style:", error);
		return defaultStyle;
	}
}

function applyNamingStyle(style: ClientNamingStyle) {
	document.documentElement.dataset.namingStyle = style;

	document.querySelectorAll("[data-naming-label]").forEach((label) => {
		const defaultLabel =
			label.getAttribute("data-default-label") ||
			label.textContent ||
			"";
		const poeticLabel =
			label.getAttribute("data-poetic-label") || defaultLabel;

		label.textContent = style === "poetic" ? poeticLabel : defaultLabel;
	});

	const switchButton = document.querySelector<HTMLElement>(
		"[data-naming-style-switch]",
	);
	if (switchButton) {
		switchButton.dataset.namingStyle = style;
		switchButton.setAttribute("aria-pressed", String(style === "poetic"));
		switchButton.setAttribute(
			"title",
			style === "poetic" ? "切换为默认命名" : "切换为雅称命名",
		);
	}
}

function bindNamingStyleSwitch() {
	const switchButton = document.querySelector<HTMLElement>(
		"[data-naming-style-switch]",
	);
	if (!switchButton || switchButton.dataset.namingStyleBound === "true") {
		return;
	}

	switchButton.dataset.namingStyleBound = "true";
	switchButton.addEventListener("click", () => {
		const { defaultStyle, storageKey } = getNamingStyleConfig();
		const nextStyle: ClientNamingStyle =
			getNamingStyle() === "poetic" ? defaultStyle : "poetic";

		try {
			localStorage.setItem(storageKey, nextStyle);
		} catch (error) {
			console.error("Failed to save naming style:", error);
		}

		applyNamingStyle(nextStyle);
	});
}

function initNamingStyle() {
	applyNamingStyle(getNamingStyle());
	bindNamingStyleSwitch();
}

document.addEventListener("DOMContentLoaded", initNamingStyle);
document.addEventListener("astro:page-load", initNamingStyle);
document.addEventListener("swup:contentReplaced", initNamingStyle);

// 为semifull模式添加滚动检测逻辑
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) {return;}
    
    // 移除之前的滚动事件监听器（如果存在）
    // @ts-ignore
    if (window.semifullScrollHandler) {
        // @ts-ignore
        window.removeEventListener('scroll', window.semifullScrollHandler);
    }
    
    // 获取当前是否为首页
    // @ts-ignore
    const isHomePage = navbar.dataset.isHome === 'true';

    // 如果不是首页，在平板/桌面端强制显示为scrolled状态
    if (!isHomePage) {
        navbar.classList.add('scrolled');
        return;
    }
    
    let ticking = false;
    
    function updateNavbarState() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const threshold = 50; // 滚动阈值，可以根据需要调整
        
        if (navbar && scrollTop > threshold) {
            navbar.classList.add('scrolled');
        } else if (navbar) {
            navbar.classList.remove('scrolled');
        }
        
        ticking = false;
    }
    
    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }
    
    // 保存新的事件处理器引用
    // @ts-ignore
    window.semifullScrollHandler = requestTick;
    
    // 监听滚动事件
    window.addEventListener('scroll', requestTick, { passive: true });
    
    // 初始化状态
    updateNavbarState();
}

// 将函数暴露到全局对象，供页面切换时调用
// @ts-ignore
window.initSemifullScrollDetection = initSemifullScrollDetection;

// 页面加载完成后初始化滚动检测
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
</script>

<style>
	@keyframes nav-poetic-cloud-breathe {
		0% {
			opacity: 0.72;
			filter: blur(0.08rem);
		}
		100% {
			opacity: 1;
			filter: blur(0.03rem);
		}
	}

	#navbar[data-is-home="false"] .naming-style-switch {
		display: none;
	}

	.naming-style-switch {
		min-width: 3.35rem;
	}

	.naming-style-switch__rail {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.2rem;
		border-radius: 9999px;
		background: color-mix(
			in srgb,
			var(--btn-plain-bg-hover) 82%,
			white 18%
		);
	}

	.naming-style-switch__chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 9999px;
		font-size: 0.75rem;
		font-weight: 700;
		color: rgb(15 23 42 / 0.65);
		transition:
			background-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	:global(.dark) .naming-style-switch__rail {
		background: color-mix(
			in srgb,
			var(--btn-plain-bg-hover) 88%,
			black 12%
		);
	}

	:global(.dark) .naming-style-switch__chip {
		color: rgb(248 250 252 / 0.72);
	}

	.naming-style-switch[data-naming-style="default"]
		.naming-style-switch__chip[data-style-chip="default"],
	.naming-style-switch[data-naming-style="poetic"]
		.naming-style-switch__chip[data-style-chip="poetic"] {
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		transform: translateY(-1px);
	}

	:global(html[data-naming-style="poetic"] .nav-label) {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		overflow: visible;
		text-overflow: clip;
		white-space: nowrap;
		line-height: 1;
		isolation: isolate;
		contain: paint;
		transition:
			color 220ms ease,
			transform 220ms ease,
			text-shadow 220ms ease,
			box-shadow 220ms ease,
			background-color 220ms ease,
			border-color 220ms ease,
			background-position 240ms ease,
			opacity 220ms ease;
		font-family:
			"Noto Serif SC",
			"Source Han Serif SC",
			"Songti SC",
			"STSong",
			"SimSun",
			serif;
	}

	:global(html[data-naming-style="poetic"] .nav-label::before),
	:global(html[data-naming-style="poetic"] .nav-label::after) {
		transition:
			opacity 220ms ease,
			transform 220ms ease,
			box-shadow 220ms ease,
			background-position 240ms ease,
			filter 220ms ease;
	}

	:global(html[data-naming-style="poetic"] .nav-label--top) {
		min-height: 1.8rem;
		padding: 0.3rem 0.72rem 0.34rem;
		border-radius: 999px;
	}

	:global(html[data-naming-style="poetic"] .nav-label--child) {
		min-height: 1.55rem;
		padding: 0.22rem 0.56rem 0.26rem;
		border-radius: 0.82rem;
		font-size: 0.94em;
		letter-spacing: 0.1em;
	}

	:global(html[data-naming-style="poetic"] .btn-plain:hover .nav-label),
	:global(html[data-naming-style="poetic"] .btn-plain:focus-visible .nav-label),
	:global(html[data-naming-style="poetic"] .dropdown-trigger[aria-expanded="true"] .nav-label),
	:global(html[data-naming-style="poetic"] .dropdown-item:hover .nav-label),
	:global(html[data-naming-style="poetic"] [data-mobile-dropdown-trigger]:hover .nav-label),
	:global(html[data-naming-style="poetic"] [data-mobile-dropdown-trigger][aria-expanded="true"] .nav-label),
	:global(html[data-naming-style="poetic"] .mobile-submenu a:hover .nav-label) {
		transform: translateY(-1px) scale(1.03);
	}

	:global(html[data-naming-style="poetic"] .nav-label[data-poetic-variant="mountain"]) {
		padding-left: 0.98rem;
		border: 1px solid rgb(102 141 112 / 0.24);
		background:
			linear-gradient(180deg, rgb(239 247 241 / 0.98), rgb(222 236 226 / 0.86)),
			radial-gradient(circle at 16% 18%, rgb(255 255 255 / 0.88), transparent 50%);
		color: rgb(36 76 49 / 0.98);
		font-weight: 800;
		letter-spacing: 0.16em;
		box-shadow: 0 0.2rem 0.55rem rgb(45 90 58 / 0.08);
	}

	:global(html[data-naming-style="poetic"] .nav-label[data-poetic-variant="mountain"]::before) {
		content: "";
		position: absolute;
		left: 0;
		top: 15%;
		bottom: 15%;
		width: 0.26rem;
		border-radius: 999px 0.14rem 0.14rem 999px;
		background: linear-gradient(
			180deg,
			rgb(45 90 58 / 0.98) 0%,
			rgb(106 154 122 / 0.9) 82%,
			transparent 100%
		);
		clip-path: polygon(0% 0%, 100% 30%, 100% 70%, 0% 100%);
		box-shadow: 0 0 0.75rem rgb(45 90 58 / 0.16);
	}

	:global(html[data-naming-style="poetic"] .nav-label[data-poetic-variant="water"]) {
		border: 1px solid rgb(129 171 189 / 0.24);
		background:
			linear-gradient(180deg, rgb(241 249 252 / 0.98), rgb(224 236 242 / 0.88)),
			radial-gradient(circle at 18% 18%, rgb(255 255 255 / 0.88), transparent 52%);
		color: rgb(49 95 118 / 0.98);
		font-weight: 700;
		letter-spacing: 0.16em;
		box-shadow: 0 0.2rem 0.6rem rgb(90 122 138 / 0.08);
	}

	:global(html[data-naming-style="poetic"] .nav-label[data-poetic-variant="water"]::after) {
		content: "";
		position: absolute;
		left: 0.42rem;
		right: 0.42rem;
		bottom: 0.14rem;
		height: 0.16rem;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			transparent,
			rgb(138 179 201 / 0.86) 18%,
			rgb(90 122 138 / 0.96) 50%,
			rgb(138 179 201 / 0.86) 82%,
			transparent
		);
		opacity: 0.82;
		box-shadow: 0 0.08rem 0.55rem rgb(138 179 201 / 0.22);
	}

	:global(html[data-naming-style="poetic"] .nav-label[data-poetic-variant="seal"]) {
		padding-left: 1rem;
		border: 1px solid rgb(197 157 151 / 0.28);
		background: linear-gradient(180deg, rgb(252 245 242 / 0.98), rgb(247 232 228 / 0.88));
		color: rgb(77 51 47 / 0.98);
		font-weight: 700;
		letter-spacing: 0.14em;
		box-shadow: 0 0.2rem 0.58rem rgb(181 131 123 / 0.08);
	}

	:global(html[data-naming-style="poetic"] .nav-label[data-poetic-variant="seal"]::before) {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		width: 0.52rem;
		height: 0.52rem;
		border-radius: 0.12rem;
		background: linear-gradient(135deg, rgb(181 131 123), rgb(164 95 86));
		transform: translateY(-50%) rotate(-8deg);
		box-shadow: 0.12rem 0.12rem 0.42rem rgb(181 131 123 / 0.2);
		outline: 1px solid rgb(252 245 242 / 0.58);
		outline-offset: -0.08rem;
	}

	:global(html[data-naming-style="poetic"] .nav-label[data-poetic-variant="ink"]) {
		border-radius: 0.42rem;
		border: 1px solid rgb(223 214 204 / 0.72);
		background:
			repeating-linear-gradient(
				0deg,
				transparent,
				transparent 1rem,
				rgb(200 185 170 / 0.12) 1rem,
				rgb(200 185 170 / 0.12) 1.08rem
			),
			linear-gradient(180deg, rgb(248 243 236 / 0.99), rgb(239 231 220 / 0.9));
		box-shadow:
			inset 0 0 0 1px rgb(236 228 218 / 0.95),
			0 0.18rem 0.48rem rgb(0 0 0 / 0.05);
		font-family:
			"萝莉体 第二版",
			"KaiTi",
			"STKaiti",
