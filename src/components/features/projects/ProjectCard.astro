---
import { Icon } from "astro-icon/components";

import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import type { ProjectCardProps } from "./types";

const { project, maxTechStack = 4 } = Astro.props as ProjectCardProps;

const hasImage = !!project.image;
const showImageArea = project.showImage !== false && hasImage;
const hasVisitUrl = !!project.visitUrl;
const hasSourceCode = !!project.sourceCode;
const hasTags = (project.tags?.length ?? 0) > 0;

const getCategoryText = (category: string) => {
	switch (category) {
		case "web":
			return i18n(I18nKey.projectsWeb);
		case "mobile":
			return i18n(I18nKey.projectsMobile);
		case "desktop":
			return i18n(I18nKey.projectsDesktop);
		case "other":
			return i18n(I18nKey.projectsOther);
		default:
			return category;
	}
};

const getStatusText = (status: string) => {
	switch (status) {
		case "completed":
			return i18n(I18nKey.projectsCompleted);
		case "in-progress":
			return i18n(I18nKey.projectsInProgress);
		case "planned":
			return i18n(I18nKey.projectsPlanned);
		default:
			return status;
	}
};

const watermarkText =
	project.id === "mr-trip" ? "TRIP" : project.title.slice(0, 4).toUpperCase();
---

<article
	class="project-card group relative overflow-hidden transition-all duration-300"
	data-category={project.category}
>
	<div class="project-card-shell">
		{
			showImageArea && (
				<div class="project-media">
					{hasImage ? (
						<img
							src={project.image!}
							alt={project.title}
							class="project-cover"
							loading="lazy"
						/>
					) : (
						<div class="w-full h-full flex items-center justify-center">
							<span class="text-4xl font-bold text-[var(--primary)]/15 select-none tracking-wide">
								{project.title}
							</span>
						</div>
					)}
					<div class="project-media-overlay"></div>
					<div class="project-media-badge">
						<span>{project.title}</span>
						<small>AI Travel Planner</small>
					</div>
				</div>
			)
		}

		<div class="project-copy">
			<div class="project-topline">
				<span class="project-category-pill">
					<Icon
						name="material-symbols:language"
						class="text-[1rem] shrink-0"
					/>
					{getCategoryText(project.category)}
				</span>
				{
					hasSourceCode && (
						<a
							href={project.sourceCode!}
							target="_blank"
							rel="noopener noreferrer"
							class="project-source-pill"
						>
							<Icon name="mdi:github" class="text-[1rem] shrink-0" />
							<span>{i18n(I18nKey.projectsGitHub)}</span>
							{
								project.featured && (
									<Icon
										name="material-symbols:star-rounded"
										class="text-[1.05rem]"
									/>
								)
							}
						</a>
					)
				}
			</div>

			{
				project.featured && (
					<p class="project-eyebrow">{i18n(I18nKey.projectsFeatured)}</p>
				)
			}

			<div class="project-heading">
				<h3 class="project-title">{project.title}</h3>
				<span class="project-status">{getStatusText(project.status)}</span>
			</div>

			<p class="project-description">{project.description}</p>

			{
				hasTags && (
					<div class="project-tag-row">
						{project.tags!.map((tag) => (
							<span class="project-tag">#{tag}</span>
						))}
					</div>
				)
			}

			{
				project.techStack && project.techStack.length > 0 && (
					<div class="project-tech-row">
						{project.techStack.slice(0, maxTechStack).map((tech) => (
							<span class="project-tech-chip">{tech}</span>
						))}
						{project.techStack.length > maxTechStack && (
							<span class="project-tech-chip project-tech-chip-muted">
								+{project.techStack.length - maxTechStack}
							</span>
						)}
					</div>
				)
			}

			{
				(hasVisitUrl || hasSourceCode) && (
					<div class="project-actions">
						{hasVisitUrl && (
							<a
								href={project.visitUrl!}
								target="_blank"
								rel="noopener noreferrer"
								class="project-action project-action-primary"
							>
								<Icon
									name="material-symbols:open-in-new-rounded"
									class="text-[1.15rem]"
								/>
								{i18n(I18nKey.projectsDemo)}
							</a>
						)}
						{hasSourceCode && (
							<a
								href={project.sourceCode!}
								target="_blank"
								rel="noopener noreferrer"
								class="project-action project-action-secondary"
							>
								<Icon name="mdi:github" class="text-[1.15rem]" />
								{i18n(I18nKey.projectsGitHub)}
							</a>
						)}
					</div>
				)
			}

			<div class="project-watermark" aria-hidden="true">
				{watermarkText}
			</div>
	</div>
</article>

<style>
	.project-card {
		animation: fadeInUp 0.5s ease-out forwards;
		opacity: 0;
	}

	.project-card.filtered-out {
		display: none;
	}

	.project-card-shell {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		overflow: hidden;
		border-radius: 1.75rem;
		border: 1px solid
			color-mix(in oklab, var(--primary) 18%, var(--line-divider));
		background:
			radial-gradient(
				circle at top right,
				color-mix(in oklab, var(--primary) 16%, transparent),
				transparent 28%
			),
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--card-bg) 96%, white 4%),
				color-mix(in oklab, var(--card-bg) 92%, var(--primary) 8%)
			);
		box-shadow:
			0 30px 60px -38px color-mix(in oklab, var(--primary) 24%, transparent),
			0 10px 24px -20px color-mix(in oklab, var(--primary) 12%, transparent);
		transition:
			transform 0.28s ease,
			box-shadow 0.28s ease,
			border-color 0.28s ease;
	}

	.project-card:hover .project-card-shell {
		transform: translateY(-4px);
		border-color: color-mix(in oklab, var(--primary) 42%, var(--line-divider));
		box-shadow:
			0 36px 72px -42px color-mix(in oklab, var(--primary) 32%, transparent),
			0 16px 32px -22px color-mix(in oklab, var(--primary) 16%, transparent);
	}

	.project-media {
		position: relative;
		min-height: 18rem;
		overflow: hidden;
	}

	.project-cover {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.001);
		transition: transform 0.55s ease;
	}

	.project-card:hover .project-cover {
		transform: scale(1.045);
	}

	.project-media-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				to top,
				color-mix(in oklab, var(--primary) 24%, black 12%),
				transparent 44%
			),
			linear-gradient(
				to right,
				color-mix(in oklab, var(--primary) 12%, white 88%),
				transparent 58%
			);
	}

	.project-media-badge {
		position: absolute;
		left: 1.25rem;
		right: 1.25rem;
		bottom: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 1rem 1.05rem;
		border-radius: 1.1rem;
		background: color-mix(in oklab, var(--card-bg) 84%, white 16%);
		border: 1px solid color-mix(in oklab, var(--primary) 12%, transparent);
		backdrop-filter: blur(14px);
		box-shadow:
			0 14px 36px -26px color-mix(in oklab, var(--primary) 18%, transparent);
	}

	.project-media-badge span {
		font-size: 1.25rem;
		font-weight: 800;
		color: color-mix(in oklab, var(--primary) 56%, black 44%);
		line-height: 1.1;
	}

	.project-media-badge small {
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: color-mix(in oklab, var(--primary) 64%, transparent);
	}

	.project-copy {
		position: relative;
		padding: 1.45rem 1.45rem 1.35rem;
	}

	.project-topline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem;
		flex-wrap: wrap;
	}

	.project-category-pill,
	.project-source-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		padding: 0.5rem 0.92rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1;
	}

	.project-category-pill {
		background: color-mix(in oklab, var(--card-bg) 90%, white 10%);
		border: 1px solid color-mix(in oklab, var(--primary) 18%, transparent);
		color: color-mix(in oklab, var(--primary) 64%, black 36%);
		box-shadow:
			0 12px 28px -24px color-mix(in oklab, var(--primary) 18%, transparent);
	}

	.project-source-pill {
		background: color-mix(in oklab, var(--primary) 10%, white 90%);
		border: 1px solid color-mix(in oklab, var(--primary) 24%, transparent);
		color: color-mix(in oklab, var(--primary) 72%, black 28%);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.project-source-pill:hover {
		transform: translateY(-1px);
		box-shadow:
			0 14px 30px -22px color-mix(in oklab, var(--primary) 26%, transparent);
	}

	.project-eyebrow {
		margin-top: 1.15rem;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: color-mix(in oklab, var(--primary) 72%, black 28%);
	}

	.project-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 0.55rem;
	}

	.project-title {
		font-size: clamp(1.9rem, 3.7vw, 2.4rem);
		line-height: 1.12;
		font-weight: 900;
		max-width: 9ch;
		color: color-mix(in oklab, var(--deep-text) 92%, black 8%);
	}

	.project-status {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		padding: 0.46rem 0.9rem;
		border-radius: 999px;
		background: color-mix(in oklab, var(--primary) 12%, white 88%);
		color: color-mix(in oklab, var(--primary) 74%, black 26%);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.project-description {
		position: relative;
		z-index: 1;
		margin-top: 1rem;
		max-width: 40rem;
		font-size: 1rem;
		line-height: 1.95;
		color: color-mix(in oklab, var(--deep-text) 72%, transparent);
	}

	.project-tag-row,
	.project-tech-row {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.project-tag-row {
		margin-top: 1.15rem;
	}

	.project-tech-row {
		margin-top: 1rem;
	}

	.project-tag,
	.project-tech-chip {
		display: inline-flex;
		align-items: center;
		padding: 0.42rem 0.8rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.2;
	}

	.project-tag {
		background: color-mix(in oklab, var(--primary) 10%, white 90%);
		color: color-mix(in oklab, var(--primary) 72%, black 28%);
	}

	.project-tech-chip {
		background: color-mix(in oklab, var(--card-bg) 92%, white 8%);
		border: 1px solid color-mix(in oklab, var(--primary) 18%, transparent);
		color: color-mix(in oklab, var(--primary) 70%, black 30%);
		box-shadow:
			0 10px 20px -24px color-mix(in oklab, var(--primary) 18%, transparent);
	}

	.project-tech-chip-muted {
		color: var(--content-meta);
	}

	.project-actions {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 1.45rem;
	}

	.project-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-width: 10rem;
		padding: 0.95rem 1.2rem;
		border-radius: 1rem;
		font-size: 1rem;
		font-weight: 800;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	.project-action:hover {
		transform: translateY(-1px);
	}

	.project-action-primary {
		background:
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--primary) 18%, white 82%),
				color-mix(in oklab, var(--primary) 28%, white 72%)
			);
		color: color-mix(in oklab, var(--primary) 74%, black 26%);
		box-shadow:
			0 18px 34px -28px color-mix(in oklab, var(--primary) 30%, transparent);
	}

	.project-action-secondary {
		background: color-mix(in oklab, var(--card-bg) 94%, white 6%);
		border: 1px solid color-mix(in oklab, var(--primary) 18%, transparent);
		color: color-mix(in oklab, var(--primary) 66%, black 34%);
	}

	.project-watermark {
		position: absolute;
		right: 1.15rem;
		bottom: 1rem;
		font-size: clamp(4rem, 11vw, 7rem);
		font-weight: 900;
		line-height: 0.9;
		letter-spacing: -0.06em;
		color: color-mix(in oklab, var(--primary) 18%, transparent);
		pointer-events: none;
		user-select: none;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.project-card:nth-child(1) {
		animation-delay: 0.05s;
	}
	.project-card:nth-child(2) {
		animation-delay: 0.1s;
	}
	.project-card:nth-child(3) {
		animation-delay: 0.15s;
	}
	.project-card:nth-child(4) {
		animation-delay: 0.2s;
	}
	.project-card:nth-child(5) {
		animation-delay: 0.25s;
	}
	.project-card:nth-child(6) {
		animation-delay: 0.3s;
	}
	.project-card:nth-child(7) {
		animation-delay: 0.35s;
	}
	.project-card:nth-child(8) {
		animation-delay: 0.4s;
	}

	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (min-width: 900px) {
		.project-card-shell {
			grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
		}

		.project-media {
			min-height: 100%;
		}

		.project-copy {
			padding: 1.7rem 1.75rem 1.55rem;
		}
	}

	@media (max-width: 768px) {
		.project-card-shell {
			border-radius: 1.45rem;
		}

		.project-media {
			min-height: 14.5rem;
		}

		.project-media-badge {
			left: 1rem;
			right: 1rem;
			bottom: 1rem;
			padding: 0.9rem;
		}

		.project-copy {
			padding: 1.15rem 1.05rem 1.1rem;
		}

		.project-heading {
			flex-direction: column;
			gap: 0.6rem;
		}

		.project-title {
			font-size: 1.75rem;
		}

		.project-description {
			font-size: 0.96rem;
			line-height: 1.8;
		}

		.project-actions {
			flex-direction: column;
		}

		.project-action {
			width: 100%;
		}

		.project-watermark {
			font-size: 4.1rem;
			right: 0.9rem;
			bottom: 0.8rem;
		}
	}

	:global(.dark) .project-card-shell {
		border-color: color-mix(in oklab, var(--primary) 18%, transparent);
		background:
			radial-gradient(
				circle at top right,
				color-mix(in oklab, var(--primary) 18%, transparent),
				transparent 26%
			),
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--card-bg) 94%, black 6%),
				color-mix(in oklab, var(--card-bg) 88%, var(--primary) 12%)
			);
		box-shadow:
			0 28px 60px -42px rgba(0, 0, 0, 0.72),
			0 10px 24px -18px rgba(0, 0, 0, 0.38);
	}

	:global(.dark) .project-media-badge {
		background: color-mix(in oklab, var(--card-bg) 82%, black 18%);
		border-color: color-mix(in oklab, var(--primary) 22%, transparent);
	}

	:global(.dark) .project-media-badge span {
		color: color-mix(in oklab, white 72%, var(--primary) 28%);
	}

	:global(.dark) .project-media-badge small {
		color: color-mix(in oklab, white 56%, var(--primary) 44%);
	}

	:global(.dark) .project-category-pill {
		background: color-mix(in oklab, var(--card-bg) 86%, black 14%);
		border-color: color-mix(in oklab, var(--primary) 18%, transparent);
		color: color-mix(in oklab, white 60%, var(--primary) 40%);
	}

	:global(.dark) .project-source-pill {
		background: color-mix(in oklab, var(--primary) 18%, black 82%);
		border-color: color-mix(in oklab, var(--primary) 28%, transparent);
		color: color-mix(in oklab, white 54%, var(--primary) 46%);
	}

	:global(.dark) .project-eyebrow {
		color: color-mix(in oklab, white 54%, var(--primary) 46%);
	}

	:global(.dark) .project-title {
		color: color-mix(in oklab, white 92%, var(--primary) 8%);
	}

	:global(.dark) .project-status {
		background: color-mix(in oklab, var(--primary) 20%, black 80%);
		color: color-mix(in oklab, white 56%, var(--primary) 44%);
	}

	:global(.dark) .project-description {
		color: color-mix(in oklab, white 74%, var(--primary) 26%);
	}

	:global(.dark) .project-tag {
		background: color-mix(in oklab, var(--primary) 18%, black 82%);
		color: color-mix(in oklab, white 56%, var(--primary) 44%);
	}

	:global(.dark) .project-tech-chip {
		background: color-mix(in oklab, var(--card-bg) 90%, black 10%);
		border-color: color-mix(in oklab, var(--primary) 16%, transparent);
		color: color-mix(in oklab, white 58%, var(--primary) 42%);
	}

	:global(.dark) .project-tech-chip-muted {
		color: color-mix(in oklab, white 58%, transparent);
	}

	:global(.dark) .project-action-primary {
		background:
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--primary) 44%, black 56%),
				color-mix(in oklab, var(--primary) 34%, black 66%)
			);
		color: color-mix(in oklab, white 92%, var(--primary) 8%);
	}

	:global(.dark) .project-action-secondary {
		background: color-mix(in oklab, var(--card-bg) 92%, black 8%);
		border-color: color-mix(in oklab, var(--primary) 16%, transparent);
		color: color-mix(in oklab, white 68%, var(--primary) 32%);
	}

	:global(.dark) .project-watermark {
		color: color-mix(in oklab, var(--primary) 18%, transparent);
	}
</style>
