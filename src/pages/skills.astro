---
import { FilterTabs } from "@components/atoms/filter-tabs";
import { SkillCard } from "@components/features/skills";
import RuntimeIcon from "@components/misc/Icon.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

import { siteConfig } from "../config";
import { skillsData, type Skill } from "../data/skills";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.featurePages.skills) {
	return Astro.redirect("/404/");
}

const categoryMeta = {
	backend: {
		label: "后端",
		icon: "material-symbols:dns",
		color: "#8B5CF6",
	},
	database: {
		label: "数据库",
		icon: "material-symbols:storage",
		color: "#10B981",
	},
	tools: {
		label: "工具",
		icon: "material-symbols:build",
		color: "#F59E0B",
	},
	frontend: {
		label: "前端",
		icon: "material-symbols:web",
		color: "#3B82F6",
	},
	other: {
		label: "其他",
		icon: "material-symbols:widgets",
		color: "#EC4899",
	},
} as const;

const levelMeta = {
	expert: { label: i18n(I18nKey.skillsExpert), color: "#EF4444" },
	advanced: { label: i18n(I18nKey.skillsAdvanced), color: "#F97316" },
	intermediate: { label: i18n(I18nKey.skillsIntermediate), color: "#F59E0B" },
	beginner: { label: i18n(I18nKey.skillsBeginner), color: "#22C55E" },
} as const;

const categoryOrder = ["backend", "database", "tools", "frontend", "other"] as const;
const categories = categoryOrder.filter((category) =>
	skillsData.some((skill) => skill.category === category),
);

const formatExperience = (exp: { years: number; months: number }) => {
	const parts: string[] = [];
	if (exp.years > 0) {
		parts.push(`${exp.years} ${i18n(I18nKey.skillYears)}`);
	}
	if (exp.months > 0) {
		parts.push(`${exp.months} ${i18n(I18nKey.skillMonths)}`);
	}
	return parts.join(" ");
};

const countByCategory = (category: keyof typeof categoryMeta) =>
	skillsData.filter((skill) => skill.category === category).length;

const focusSkills = ["ai-agent", "java", "spring-boot"]
	.map((id) => skillsData.find((skill) => skill.id === id))
	.filter((skill): skill is Skill => Boolean(skill));

const focusSkillMeta: Record<
	string,
	{
		chips: string[];
		points: string[];
	}
> = {
	"ai-agent": {
		chips: ["探索中"],
		points: ["工具调用 / 工作流", "提示词工程落地"],
	},
	java: {
		chips: ["主力", "高级"],
		points: ["接口开发 / 业务逻辑", "服务端功能实现"],
	},
	"spring-boot": {
		chips: ["高级"],
		points: ["接口设计 / 业务分层", "基础配置与集成"],
	},
};

const focusSkillCards = focusSkills.map((skill) => ({
	...skill,
	meta: focusSkillMeta[skill.id] ?? {
		chips: [levelMeta[skill.level].label],
		points: [],
	},
}));

const filterTabs = [
	{
		value: "all",
		label: i18n(I18nKey.friendsFilterAll),
		count: skillsData.length,
	},
	...categories.map((category) => ({
		value: category,
		label: categoryMeta[category].label,
		count: countByCategory(category),
	})),
];

const title = i18n(I18nKey.skills);
const subtitle = "以 Java 后端为主，持续探索 AI Agent 与全栈协作开发";
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
		import { loadIconify } from "../utils/icon-loader";

		loadIconify().catch((error) => {
			console.error("Failed to load Iconify:", error);
		});
	</script>

	<script is:inline src="/js/filter-tabs-handler.js"></script>

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base skills-page-card z-10 px-6 sm:px-9 py-6 relative w-full">
			<section class="skills-focus-panel mb-8">
				<div class="skills-focus-copy">
					<div class="skills-focus-kicker">
						<span class="skills-focus-kicker-dot"></span>
						当前重点探索
					</div>
					<h1>
						智能体与 <span>后端协同</span>
					</h1>
					<p>
						深挖
						<strong>工具调用 (Tool Calling)</strong>、
						<strong>工作流编排 (Workflow)</strong>
						与
						<strong>提示词设计 (Prompt)</strong>
						，将智能体能力持续落地到真实项目。同时夯实
						<strong>Java 后端工程化</strong>
						，打通
						<strong>AI + 服务端</strong>
						的最后一公里。
					</p>
				</div>

				<div class="skills-focus-list">
					{
						focusSkillCards.map((skill) => {
							return (
								<article
									class="skills-focus-card"
									style={`--skill-color: ${skill.color ?? "#3B82F6"};`}
								>
									<div class="skills-focus-card-head">
										<div class="skills-focus-card-title">
											<span class="skills-focus-card-icon">
												<RuntimeIcon
													icon={skill.icon}
													color={skill.color ?? "#3B82F6"}
													fallback={skill.name.charAt(0)}
													class="text-[1rem]"
													loading="eager"
												/>
											</span>
											<strong>{skill.name}</strong>
											<div class="skills-focus-card-chips">
												{
													skill.meta.chips.map((chip, chipIndex) => (
														<span
															class:list={[
																"skills-focus-card-chip",
																{
																	primary: chipIndex === 0,
																	secondary: chipIndex > 0,
																},
															]}
														>
															{chip}
														</span>
													))
												}
											</div>
										</div>
										<span class="skills-focus-card-exp">
											{formatExperience(skill.experience)}
										</span>
									</div>
									<ul class="skills-focus-card-points">
										{
											skill.meta.points.map((point) => (
												<li>{point}</li>
											))
										}
									</ul>
								</article>
							);
						})
					}
				</div>

				<div class="skills-focus-footer" aria-label="技术标签">
					<div class="skills-focus-footer-title">
						<Icon name="material-symbols:label" />
						技术标签
					</div>
					<div class="skills-focus-tags">
						<span>AI Agent 实践</span>
						<span>Java 后端</span>
						<span>智能体协同</span>
						<span>工程化落地</span>
					</div>
					<div class="skills-focus-status">
						<Icon name="material-symbols:auto-awesome" />
						持续迭代中
					</div>
				</div>
			</section>

			<div class="mb-7">
				<FilterTabs tabs={filterTabs} dataAttr="category" class="skills-filter-tabs" />
			</div>

			<div id="skills-grid" class="skills-category-list">
				{
					categories.map((category) => (
						<section class="skills-category-section" data-category={category}>
							<h2>
								<Icon
									name={categoryMeta[category].icon}
									class="category-title-icon"
									style={`color: ${categoryMeta[category].color}`}
								/>
								{categoryMeta[category].label}
								<span>({countByCategory(category)})</span>
							</h2>
							<div class="skills-category-grid">
								{skillsData
									.filter((skill) => skill.category === category)
									.map((skill) => <SkillCard skill={skill} />)}
							</div>
						</section>
					))
				}
			</div>

			<div id="no-results" class="hidden text-center py-16">
				<Icon
					name="material-symbols:search-off-rounded"
					class="text-6xl text-black/15 dark:text-white/15 mb-4"
				/>
				<p class="text-black/40 dark:text-white/40 text-lg">
					No matching skills
				</p>
			</div>
		</div>
	</div>
</MainGridLayout>

<style is:global>
	.skills-page-card {
		background:
			radial-gradient(circle at 20% 31%, rgba(255, 219, 231, 0.62) 0 0.72rem, transparent 0.78rem),
			radial-gradient(circle at 83% 42%, rgba(255, 219, 231, 0.58) 0 0.62rem, transparent 0.68rem),
			radial-gradient(circle at 76% 82%, rgba(255, 219, 231, 0.52) 0 0.7rem, transparent 0.76rem),
			rgba(255, 255, 255, 0.92);
	}

	.dark .skills-page-card {
		background:
			radial-gradient(circle at 20% 31%, rgba(236, 72, 153, 0.22) 0 0.72rem, transparent 0.78rem),
			radial-gradient(circle at 83% 42%, rgba(236, 72, 153, 0.18) 0 0.62rem, transparent 0.68rem),
			radial-gradient(circle at 76% 82%, rgba(236, 72, 153, 0.16) 0 0.7rem, transparent 0.76rem),
			rgba(15, 23, 42, 0.88);
	}

	.skills-focus-panel {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.45rem;
		padding: clamp(1.3rem, 3.6vw, 1.9rem);
		overflow: hidden;
		border: 1px solid rgba(148, 163, 184, 0.22);
		border-radius: 1.42rem;
		background:
			linear-gradient(135deg, rgba(250, 252, 255, 0.98), rgba(255, 251, 245, 0.92) 52%, rgba(253, 245, 248, 0.88)),
			rgba(255, 255, 255, 0.88);
		box-shadow: 0 16px 34px rgba(15, 23, 42, 0.07);
	}

	.skills-focus-panel::before,
	.skills-focus-panel::after {
		position: absolute;
		content: "";
		width: 1.35rem;
		height: 0.72rem;
		border-radius: 999px 999px 999px 0;
		background: rgba(255, 205, 225, 0.48);
		filter: blur(0.5px);
		transform: rotate(24deg);
		pointer-events: none;
	}

	.skills-focus-panel::before {
		top: 18%;
		right: 16%;
	}

	.skills-focus-panel::after {
		right: 4%;
		bottom: 8%;
		width: 1.55rem;
		height: 0.85rem;
		transform: rotate(-68deg);
	}

	.dark .skills-focus-panel {
		background:
			linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(76, 29, 149, 0.18)),
			rgba(15, 23, 42, 0.9);
		border-color: rgba(255, 255, 255, 0.1);
	}

	.skills-focus-copy {
		position: relative;
		z-index: 1;
		min-width: 0;
	}

	.skills-focus-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.42rem 0.9rem;
		border-radius: 999px;
		background: linear-gradient(90deg, rgba(59, 130, 246, 0.14), rgba(59, 130, 246, 0.04));
		color: #2563eb;
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.02em;
	}

	.skills-focus-kicker-dot {
		width: 0.56rem;
		height: 0.56rem;
		border-radius: 999px;
		background: #3b82f6;
		box-shadow: 0 0 0 0.18rem rgba(59, 130, 246, 0.16);
	}

	.skills-focus-copy h1 {
		margin-top: 1rem;
		max-width: 30rem;
		font-size: clamp(2rem, 4.1vw, 2.7rem);
		line-height: 1.18;
		font-weight: 900;
		letter-spacing: -0.04em;
		color: rgba(17, 24, 39, 0.96);
	}

	.skills-focus-copy h1 span {
		color: #2f66f3;
	}

	.dark .skills-focus-copy h1 {
		color: rgba(255, 255, 255, 0.94);
	}

	.skills-focus-copy p {
		margin-top: 1rem;
		max-width: 46rem;
		font-size: 1rem;
		line-height: 1.9;
		color: rgba(31, 41, 55, 0.66);
	}

	.skills-focus-copy p strong {
		font-weight: 800;
		color: rgba(15, 23, 42, 0.88);
	}

	.skills-focus-copy p strong:nth-of-type(3) {
		color: #7c3aed;
	}

	.dark .skills-focus-copy p {
		color: rgba(255, 255, 255, 0.68);
	}

	.skills-focus-list {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.1rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(148, 163, 184, 0.18);
	}

	.skills-focus-card {
		padding-top: 1rem;
		border-top: 3px solid color-mix(in srgb, var(--skill-color) 78%, white);
	}

	.dark .skills-focus-card {
		border-top-color: color-mix(in srgb, var(--skill-color) 68%, white);
	}

	.skills-focus-card-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.9rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px solid rgba(148, 163, 184, 0.18);
	}

	.skills-focus-card-title {
		display: flex;
		align-items: center;
		gap: 0.56rem;
		flex-wrap: wrap;
		min-width: 0;
	}

	.skills-focus-card-title strong {
		color: rgba(17, 24, 39, 0.92);
		font-size: 0.98rem;
		font-weight: 900;
	}

	.skills-focus-card-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1rem;
		height: 1rem;
		color: var(--skill-color);
		font-size: 1rem;
		flex: 0 0 auto;
	}

	.skills-focus-card-chips {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.34rem;
	}

	.skills-focus-card-chip {
		padding: 0.2rem 0.52rem;
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 800;
		line-height: 1;
	}

	.skills-focus-card-chip.primary {
		background: color-mix(in srgb, var(--skill-color) 14%, white);
		color: var(--skill-color);
	}

	.skills-focus-card-chip.secondary {
		background: rgba(15, 23, 42, 0.06);
		color: rgba(51, 65, 85, 0.76);
	}

	.skills-focus-card-exp {
		color: rgba(71, 85, 105, 0.84);
		font-size: 0.94rem;
		font-weight: 800;
		white-space: nowrap;
	}

	.skills-focus-card-points {
		display: grid;
		gap: 0.42rem;
		margin-top: 0.95rem;
		color: rgba(51, 65, 85, 0.72);
		font-size: 0.92rem;
		line-height: 1.62;
	}

	.skills-focus-card-points li {
		position: relative;
		padding-left: 0.88rem;
	}

	.skills-focus-card-points li::before {
		position: absolute;
		left: 0;
		top: 0.72em;
		width: 0.48rem;
		height: 2px;
		border-radius: 999px;
		background: var(--skill-color);
		content: "";
	}

	.skills-focus-footer {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.95rem 1rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(148, 163, 184, 0.16);
	}

	.skills-focus-footer-title,
	.skills-focus-status {
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		color: rgba(71, 85, 105, 0.84);
		font-size: 0.84rem;
		font-weight: 800;
	}

	.skills-focus-status {
		color: rgba(100, 116, 139, 0.78);
	}

	.skills-focus-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.58rem;
		flex: 1 1 auto;
	}

	.skills-focus-tags span {
		padding: 0.54rem 0.96rem;
		border: 1px solid rgba(59, 130, 246, 0.18);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.8);
		box-shadow: 0 6px 14px rgba(15, 23, 42, 0.04);
		color: rgba(30, 41, 59, 0.82);
		font-size: 0.86rem;
		font-weight: 800;
	}

	.dark .skills-focus-card-title strong,
	.dark .skills-focus-copy p strong {
		color: rgba(255, 255, 255, 0.92);
	}

	.dark .skills-focus-card-chip.secondary {
		background: rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.74);
	}

	.dark .skills-focus-card-exp,
	.dark .skills-focus-footer-title,
	.dark .skills-focus-status,
	.dark .skills-focus-card-points {
		color: rgba(255, 255, 255, 0.66);
	}

	.dark .skills-focus-tags span {
		background: rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.78);
		border-color: rgba(255, 255, 255, 0.12);
	}

	.skills-filter-tabs {
		justify-content: flex-start;
	}

	.skills-filter-tabs .filter-tabs-item {
		border-radius: 999px;
		padding: 0.58rem 1.08rem;
		background: rgba(255, 247, 237, 0.9);
		border-color: rgba(249, 115, 22, 0.24);
		box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
		color: rgba(30, 41, 59, 0.74);
	}

	.skills-filter-tabs .filter-tabs-item.active {
		background: rgba(255, 237, 213, 0.98);
		color: rgba(154, 52, 18, 0.94);
		border-color: rgba(249, 115, 22, 0.42);
	}

	.skills-filter-tabs .filter-tabs-count {
		margin-left: 0.12rem;
		opacity: 0.72;
	}

	.skills-category-list {
		display: grid;
		gap: 1.9rem;
	}

	.skills-category-section.filtered-out {
		display: none;
	}

	.skills-category-section h2 {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
		color: rgba(17, 24, 39, 0.92);
		font-size: 1.16rem;
		font-weight: 900;
	}

	.dark .skills-category-section h2 {
		color: rgba(255, 255, 255, 0.9);
	}

	.category-title-icon {
		width: 1rem;
		height: 1rem;
	}

	.skills-category-section h2 span {
		color: rgba(249, 115, 22, 0.78);
		font-size: 0.84rem;
	}

	.skills-category-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.45rem 1.55rem;
	}

	.skill-card.filtered-out {
		display: none;
	}

	@media (max-width: 880px) {
		.skills-focus-panel {
			padding: 1.2rem;
		}

		.skills-focus-list {
			grid-template-columns: 1fr;
		}

		.skills-focus-copy h1 {
			max-width: 100%;
			font-size: clamp(1.9rem, 8vw, 2.45rem);
		}

		.skills-category-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.skills-page-card {
			padding-left: 1rem;
			padding-right: 1rem;
		}

		.skills-focus-panel {
			padding: 1rem;
			border-radius: 1.1rem;
		}

		.skills-focus-kicker {
			min-width: 0;
		}

		.skills-focus-copy p {
			font-size: 0.92rem;
			line-height: 1.78;
		}

		.skills-focus-footer {
			align-items: flex-start;
		}
	}
</style>
